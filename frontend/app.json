{
  "expo": {
    "name": "Pizzabook",
    "slug": "pizzabook",
    "owner": "mrbranees-team",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.doughtimer.ia80uq"
    },
    "android": {
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.android.vending.BILLING"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D15900"
      },
      "package": "com.pizzabook.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "PizzaBook",
      "shortName": "PizzaBook",
      "lang": "en",
      "description": "Calculate pizza dough, plan fermentation, and save recipes.",
      "themeColor": "#D15900",
      "backgroundColor": "#FAF5F0",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "orientation": "any"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withTransparentAndroidSplashDrawable",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7C894",
          "android": {
            "backgroundColor": "#F7C894"
          },
          "ios": {
            "image": "./assets/images/pizza-splash-background.png",
            "imageWidth": 414,
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#F7C894"
          }
        }
      ],
      "expo-font",
      "expo-iap",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "updateManifestUrl": "https://raw.githubusercontent.com/branimirjeli-svg/pizzabook-updates/main/update.json",
      "eas": {
        "projectId": "497fc00a-4814-4a1f-abd5-fd111c073d43"
      }
    }
  }
}
