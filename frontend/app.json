{
  "expo": {
    "name": "Pizzabook",
    "slug": "pizzabook",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.doughtimer.ia80uq"
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D15900"
      },
      "package": "com.emergent.doughtimer.ia80uq"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withTransparentAndroidSplashDrawable",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7C894",
          "android": {
            "backgroundColor": "#F7C894"
          },
          "ios": {
            "image": "./assets/images/pizza-splash-background.png",
            "imageWidth": 414,
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#F7C894"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "updateManifestUrl": "https://raw.githubusercontent.com/branimirjeli-svg/pizzabook-updates/main/update.json",
      "eas": {
        "projectId": "0d36eeb4-694f-4640-bd26-583ab48a9611"
      }
    }
  }
}
