diff --git a/frontend/scripts/verify-tempering-alignment.mjs b/frontend/scripts/verify-tempering-alignment.mjs
new file mode 100644
index 0000000..b0d3454
--- /dev/null
+++ b/frontend/scripts/verify-tempering-alignment.mjs
@@ -0,0 +1,197 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { getFermentationSchedule, getTemperingWindow, reversePlan } from '../src/calculator.ts';
+import { translations } from '../src/i18n/translations.ts';
+
+const calculatorUi = await readFile(new URL('../app/(tabs)/index.tsx', import.meta.url), 'utf8');
+const plannerUi = await readFile(new URL('../app/(tabs)/planner.tsx', import.meta.url), 'utf8');
+assert.match(calculatorUi, /timer\('tempering', temperingMidpoint, 'preBake'\)/);
+assert.match(calculatorUi, /beginnerMode \? roomHours > 0 \? croatianHours\(roomHours\)[\s\S]{0,100}croatianMinutes\(temperingWindow\.initialMinutes\)/);
+assert.match(calculatorUi, /const finalRoomDuration = !beginnerMode[\s\S]{0,120}formatDuration\(temperingWindow\.initialMinutes \* 60, lang\)/);
+assert.match(plannerUi, /useFocusEffect\(useCallback/);
+assert.match(plannerUi, /getFermentationSchedule\(\{/);
+assert.match(plannerUi, /calculatorPlanSettings\.roomHours/);
+assert.match(plannerUi, /calculatorPlanSettings\.fridgeHours/);
+assert.match(plannerUi, /calculatorPlanSettings\.roomTemp/);
+assert.match(plannerUi, /isBeginner \? undefined : plannerFermentationSchedule/);
+
+assert.deepEqual(getTemperingWindow(22), {
+  minimumMinutes: 30,
+  maximumMinutes: 45,
+  initialMinutes: 38,
+});
+assert.equal(getTemperingWindow(18).initialMinutes, 68);
+assert.equal(getTemperingWindow(26).initialMinutes, 23);
+
+const durationLabels = {
+  18: {
+    hr: '1 sat i 8 minuta',
+    en: '1 hour 8 minutes',
+    de: '1 Stunde 8 Minuten',
+    sl: '1 ura in 8 minut',
+  },
+  22: {
+    hr: '38 minuta',
+    en: '38 minutes',
+    de: '38 Minuten',
+    sl: '38 minut',
+  },
+  26: {
+    hr: '23 minuta',
+    en: '23 minutes',
+    de: '23 Minuten',
+    sl: '23 minut',
+  },
+};
+const selectedSettings = {
+  roomHours: 2,
+  fridgeHours: 24,
+  fridgeTemp: 4,
+  bigaHours: 24,
+  poolishHours: 24,
+};
+const bakeAt = new Date('2026-10-20T18:00:00.000Z');
+
+function makeSelectedSchedule(method, roomTemp, settings = selectedSettings) {
+  return getFermentationSchedule({
+    method,
+    roomHours: settings.roomHours,
+    roomTemp,
+    fridgeHours: settings.fridgeHours,
+    fridgeTemp: settings.fridgeTemp,
+    ...(method === 'biga' ? { prefermentHours: settings.bigaHours } : {}),
+    ...(method === 'poolish' ? { prefermentHours: settings.poolishHours } : {}),
+  });
+}
+
+function sumHours(schedule, kind, environment) {
+  return schedule.phases
+    .filter((phase) => phase.kind === kind && phase.environment === environment)
+    .reduce((total, phase) => total + phase.hours, 0);
+}
+
+for (const style of ['neapolitan', 'romana', 'ny_style']) {
+  for (const method of ['direct', 'biga', 'poolish']) {
+    for (const roomTemp of [18, 22, 26]) {
+      for (const lang of ['hr', 'en', 'de', 'sl']) {
+        const copy = translations[lang].planner.stepCopy;
+        const schedule = makeSelectedSchedule(method, roomTemp);
+        const steps = reversePlan(
+          bakeAt,
+          method,
+          style,
+          copy,
+          null,
+          null,
+          null,
+          lang,
+          undefined,
+          roomTemp,
+          schedule,
+        );
+        const warm = steps.find((step) => step.title === copy.warmTitle);
+        const cold = steps.find((step) => step.title === copy.coldTitle);
+        const bulkTitle = method === 'direct' ? copy.bulkTitle : copy.finalBulkTitle;
+        const bulk = steps.find((step) => step.title === bulkTitle);
+        const finalRoomHours = sumHours(schedule, 'final', 'room');
+        const finalFridgeHours = sumHours(schedule, 'final', 'fridge');
+        const prefermentRoomHours = sumHours(schedule, 'preferment', 'room');
+        const prefermentFridgeHours = sumHours(schedule, 'preferment', 'fridge');
+        const temperingMinutes = getTemperingWindow(roomTemp).initialMinutes;
+
+        assert.ok(warm, `${style}/${method}/${lang} plan includes tempering`);
+        assert.equal((bakeAt.getTime() - warm.at.getTime()) / 60000, temperingMinutes);
+        assert.ok(warm.desc.includes(durationLabels[roomTemp][lang]), `${style}/${method}/${lang} instruction uses the current temperature`);
+
+        if (finalFridgeHours > 0) {
+          assert.ok(cold, `${style}/${method}/${lang} fridge schedule includes a cold stage`);
+          assert.equal((bakeAt.getTime() - cold.at.getTime()) / 60000, temperingMinutes + finalFridgeHours * 60);
+          assert.ok(cold.desc.includes(String(finalFridgeHours)), `${style}/${method}/${lang} cold description uses the selected fridge duration`);
+        } else {
+          assert.equal(cold, undefined, `${style}/${method}/${lang} room-only schedule has no cold stage`);
+        }
+
+        if (finalRoomHours > 0) {
+          assert.ok(bulk, `${style}/${method}/${lang} plan includes the final room phase`);
+          assert.equal(
+            (bakeAt.getTime() - bulk.at.getTime()) / 60000,
+            temperingMinutes + (finalFridgeHours + finalRoomHours) * 60,
+            `${style}/${method}/${lang} room phase follows the selected schedule`,
+          );
+          assert.ok(bulk.desc.includes(`${finalRoomHours} h`), `${style}/${method}/${lang} room description uses the selected room duration`);
+        } else {
+          assert.equal(bulk, undefined, `${style}/${method}/${lang} zero-hour room schedule has no bulk stage`);
+        }
+
+        if (method !== 'direct') {
+          const prefermentTitle = method === 'biga' ? copy.bigaTitle : copy.poolishTitle;
+          const preferment = steps.find((step) => step.title === prefermentTitle);
+          const selectedPrefermentHours = prefermentRoomHours + prefermentFridgeHours;
+          assert.ok(preferment, `${style}/${method}/${lang} plan includes the selected preferment`);
+          assert.equal(
+            (bakeAt.getTime() - preferment.at.getTime()) / 60000,
+            temperingMinutes + (finalRoomHours + finalFridgeHours + selectedPrefermentHours) * 60,
+          );
+          assert.ok(preferment.desc.includes(`${prefermentRoomHours} h`));
+          assert.ok(preferment.desc.includes(`${prefermentFridgeHours} h`));
+        }
+      }
+    }
+  }
+}
+
+const changedScheduleSettings = {
+  ...selectedSettings,
+  roomHours: 3,
+  fridgeHours: 18,
+};
+const changedSchedule = makeSelectedSchedule('direct', 22, changedScheduleSettings);
+const changedSteps = reversePlan(
+  bakeAt,
+  'direct',
+  'romana',
+  translations.hr.planner.stepCopy,
+  null,
+  null,
+  null,
+  'hr',
+  undefined,
+  22,
+  changedSchedule,
+);
+const changedBulk = changedSteps.find((step) => step.title === translations.hr.planner.stepCopy.bulkTitle);
+const changedCold = changedSteps.find((step) => step.title === translations.hr.planner.stepCopy.coldTitle);
+assert.equal((bakeAt.getTime() - changedBulk.at.getTime()) / 60000, 38 + (3 + 18) * 60);
+assert.equal((bakeAt.getTime() - changedCold.at.getTime()) / 60000, 38 + 18 * 60);
+assert.ok(changedBulk.desc.includes('3 h'));
+assert.ok(changedCold.desc.includes('18'));
+
+const roomOnlySchedule = makeSelectedSchedule('direct', 22, {
+  ...selectedSettings,
+  roomHours: 3,
+  fridgeHours: 0,
+});
+const roomOnlySteps = reversePlan(
+  bakeAt,
+  'direct',
+  'ny_style',
+  translations.en.planner.stepCopy,
+  null,
+  null,
+  null,
+  'en',
+  undefined,
+  22,
+  roomOnlySchedule,
+);
+const roomOnlyBulk = roomOnlySteps.find((step) => step.title === translations.en.planner.stepCopy.bulkTitle);
+assert.equal(roomOnlySteps.some((step) => step.title === translations.en.planner.stepCopy.coldTitle), false);
+assert.equal((bakeAt.getTime() - roomOnlyBulk.at.getTime()) / 60000, 38 + 3 * 60);
+
+const fermentation = makeSelectedSchedule('direct', 22);
+assert.deepEqual(fermentation.phases.map(({ environment, hours }) => ({ environment, hours })), [
+  { environment: 'room', hours: selectedSettings.roomHours },
+  { environment: 'fridge', hours: selectedSettings.fridgeHours },
+], 'Planner receives the actual production schedule selected in the calculator');
+
+console.log('Calculator-to-Planner temperature and selected fermentation schedule alignment checks passed.');
